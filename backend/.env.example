ENVIRONMENT=development
PORT=8000

JWT_SECRET=change_this_to_a_long_random_string
CORS_ORIGIN=


DATABASE_URL=

# Get test keys from https://dashboard.razorpay.com/app/keys (Test Mode toggle on)
RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: URL https://<api-host>/api/payments/webhook,
# events payment.captured + order.paid, and the secret you choose goes here.
RAZORPAY_WEBHOOK_SECRET=
CONTACT_NOTIFY_EMAIL=

SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=contact@neuintern.in
SMTP_PASSWORD=
SMTP_FROM=NeuIntern <contact@neuintern.in>

# Reminder emails to students who enrolled but have not paid. Off by default.
# Dry-run first: POST /api/admin/reminders/send?dryRun=true (admin token).
REMINDERS_ENABLED=false
FRONTEND_URL=https://www.neuintern.in
